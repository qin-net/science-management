# ResearchOS configuration. Copy to .env; .env is gitignored. Never commit real credentials.
# Defaults live in backend/researchos/config.py. Everything except DATABASE_URL is optional.

# PostgreSQL only, through the psycopg driver.
# Leave empty for local development: scripts/dev.sh starts the embedded server (data/pg).
# Production form: postgresql+psycopg://USER:PASSWORD@HOST:5432/researchos
DATABASE_URL=

# Uploaded files. Defaults to data/files in the repository.
# STORAGE_DIR=
MAX_UPLOAD_MB=50

# Sessions and browser access.
SESSION_TTL_HOURS=168
# Set to true behind HTTPS.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Comma-separated origins allowed to send state-changing requests (D-012).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Parsing. pdfium is built in. docling needs a separate environment, see the README.
PARSER_DEFAULT=pdfium
PARSE_TIMEOUT_SECONDS=600
PARSE_MAX_ATTEMPTS=3
PARSE_RETRY_BASE_SECONDS=5
# Absolute path to the python of a Docling virtualenv. Empty disables Docling.
DOCLING_PYTHON=

# Worker.
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_STALE_SECONDS=30

LOG_LEVEL=INFO

# Web: where the Next.js server forwards /api. Not read from this file: set it in the
# environment of `next dev` or `next build`, because a production build compiles it in.
# Defaults to http://127.0.0.1:8000.
# API_ORIGIN=http://127.0.0.1:8000
