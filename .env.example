# ResearchOS configuration. Copy to .env; .env is gitignored. Never commit real credentials.
# Defaults live in backend/researchos/config.py. Everything except DATABASE_URL is optional.

# PostgreSQL only, through the psycopg driver.
# Leave empty for local development: scripts/dev.sh starts the embedded server (data/pg).
# Production form: postgresql+psycopg://USER:PASSWORD@HOST:5432/researchos
DATABASE_URL=

# Uploaded files. Defaults to data/files in the repository.
# STORAGE_DIR=
MAX_UPLOAD_MB=50

# Sessions and browser access.
SESSION_TTL_HOURS=168
# Set to true behind HTTPS.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Comma-separated origins allowed to send state-changing requests (D-012).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Parsing. pdfium is built in. docling needs a separate environment, see the README.
PARSER_DEFAULT=pdfium
PARSE_TIMEOUT_SECONDS=600
PARSE_MAX_ATTEMPTS=3
PARSE_RETRY_BASE_SECONDS=5
# Absolute path to the python of a Docling virtualenv. Empty disables Docling.
DOCLING_PYTHON=

# Worker.
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_STALE_SECONDS=30

# Literature search (arXiv, OpenAlex, Crossref).
# OpenAlex shares one small free budget per IP without a key; a free key gets its own.
# Get one at https://openalex.org/settings/api. It is sent as a Bearer header, never in a URL.
OPENALEX_API_KEY=
# Sent in the User-Agent (and to Crossref as mailto) so the services can reach you. Optional.
CONTACT_EMAIL=
SEARCH_SOURCE_TIMEOUT_SECONDS=10
SEARCH_MAX_WAIT_SECONDS=8
SEARCH_CACHE_TTL_SECONDS=21600
SEARCH_USER_PER_MINUTE=10
# arXiv asks for at most one request every 3 seconds; values below 3 are rejected.
ARXIV_MIN_INTERVAL_SECONDS=3

# Language model (specs/007, D-021). Questions and the text of the selected papers are sent to
# Anthropic's Messages API. Without a key, asking returns a clear "not configured" error.
# The key is only read from the environment and is never logged or returned.
# Paragraph translation (specs/012) uses the same key, model and allowance.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_NAME=claude-sonnet-5-5
# Also the translation budget: one call sends at most this many characters of source text.
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_TIMEOUT_SECONDS=120
# Most characters of paper text one question may send; above this the question is refused.
MODEL_CONTEXT_CHARS=120000
# Per user. These two are placeholders until a cost ceiling is decided.
MODEL_USER_PER_MINUTE=5
MODEL_USER_PER_DAY=50

LOG_LEVEL=INFO

# Web: where the Next.js server forwards /api. Not read from this file: set it in the
# environment of `next dev` or `next build`, because a production build compiles it in.
# Defaults to http://127.0.0.1:8000.
# API_ORIGIN=http://127.0.0.1:8000
